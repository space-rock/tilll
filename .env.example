PORT=8080
PUBLIC_BASE_URL=http://localhost:8080        # used by the widget and in webhook links
DATA_DIR=./data
TRUST_PROXY=false                            # behind ONE reverse proxy set 1, so rate limits tell visitors apart (see README: Security)
ALLOWED_ORIGINS=*                            # comma-separated origins allowed to call /pay/*; * for the demo

ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=                            # optional partner JWT. Without one 1Click may add a platform fee; `pnpm dry-quote` shows it as appFees

# SETTLEMENT_*, PUBLIC_BASE_URL, WEBHOOK_URL, ATTEMPT_DEADLINE_MINUTES, SLIPPAGE_BPS and REFUND_MAX_* are starting values: once you change one
# in the dashboard (Settings), the saved value wins over this file until you reset it.
SETTLEMENT_ACCOUNT_ID=                       # required: the NEAR account of the wallet you will connect in the dashboard. It receives the money; that wallet approves refunds
SETTLEMENT_ASSET_ID=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1   # USDC on NEAR; checked against /v0/tokens at startup

MERCHANT_SECRET=                             # generated by `tilll init`; merchant API and dashboard auth
WEBHOOK_URL=http://localhost:9000/hooks/tilll
WEBHOOK_SECRET=                              # generated by `tilll init`

INTENTS_CONTRACT=intents.near                # the NEAR Intents verifier contract (mainnet value; a testnet uses its own)
NEAR_RPC_URL=https://rpc.mainnet.near.org    # any public RPC (docs.near.org/api/rpc/providers)

ATTEMPT_DEADLINE_MINUTES=30                  # btc, ltc, doge, bch, zec, dash always get 120
SLIPPAGE_BPS=100
EXTRA_CHAINS=                                # more chains to offer at checkout beyond EVM, sol, near, btc, tron (e.g. ltc,doge)
MEMO_CHAINS=stellar                          # chains that need depositMode=MEMO (1Click tokens list has no memo flag)
REFUND_MAX_PER_TX=50                         # in settlement asset display units
REFUND_MAX_PER_DAY=200
