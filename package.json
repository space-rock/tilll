{
  "name": "tilll",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, open-source crypto checkout on NEAR Intents.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p widget && tsc --noEmit -p dashboard && tsc --noEmit -p site",
    "build": "pnpm build:server && pnpm build:widget && pnpm build:dashboard",
    "build:server": "node scripts/build-server.mjs",
    "build:widget": "node widget/build.mjs",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "preview:site": "vite preview --config site/vite.config.ts",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test",
    "start": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "demo": "pnpm build:widget && pnpm build:dashboard && tsx scripts/demo.ts",
    "tilll": "tsx src/bin.ts",
    "demo:live": "tsx demo/main.ts",
    "webhook-receiver": "tsx demo-store/webhook-receiver.ts",
    "testnet:fund": "tsx scripts/testnet/fund.ts",
    "testnet:smoke": "tsx scripts/testnet/smoke.ts",
    "testnet:check": "tsx scripts/testnet/check.ts",
    "testnet:shop": "tsx scripts/testnet/shop.ts",
    "dry-quote": "tsx scripts/dry-quote.ts",
    "icons:update": "tsx scripts/update-icons.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/rate-limit": "^11.2.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@hot-labs/near-connect": "0.12.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "lucide-react": "1.71.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.3.4"
}
