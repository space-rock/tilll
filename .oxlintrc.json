{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "oxc/no-async-endpoint-handlers": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["node_modules", "public", "data"]
}
